{
    "name": "square1/resized-laravel",
    "description": "Laravel package for resized.co, the on-demand image manipulation service.",
    "keywords": [
        "square1",
        "resized",
        "image manipulation",
        "laravel"
    ],
    "type": "library",
    "homepage": "https://github.com/square1-io/resized-php-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Ciaran Maher",
            "email": "ciaran@square1.io"
        },
        {
            "name": "Jose Vicente Orts",
            "email": "vince@square1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "square1/resized": "^1.3|^2.0",
        "ext-iconv": "*"
    },
    "require-dev": {
        "laravel/framework": "^12.0|^13.0",
        "orchestra/testbench": "^10.0|^11.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Square1\\Laravel\\Resized\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Square1\\Laravel\\Resized\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer check --allow-risky=yes"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0-dev"
        },
        "laravel": {
            "providers": [
                "Square1\\Laravel\\Resized\\ResizedServiceProvider"
            ],
            "aliases": {
                "Resized": "Square1\\Laravel\\Resized\\ResizedFacade"
            }
        }
    }
}
